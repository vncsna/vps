[Unit]
Description=Agenvoy personal agent daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as the user whose ~/.config/agenvoy holds the config and .secrets.
User=deploy
ExecStart=/usr/local/bin/agen --daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
