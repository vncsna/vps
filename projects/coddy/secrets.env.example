# Keys this project needs, fetched from the Bitwarden item "vps/coddy".
# Add one KEY= line per secret; export-secrets.sh fills the values.
# Currently the same OpenRouter key agenvoy uses.
OPENROUTER_API_KEY=
# Fine-grained PAT scoped to the repos Coddy may read and write (Contents:
# read/write, Metadata: read), used for git clone/push.
GITHUB_TOKEN=
