[Unit]
Description=<project> daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as the user whose ~/.config/<project> holds the config and .secrets.
User=deploy
ExecStart=/usr/local/bin/<project> --daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
